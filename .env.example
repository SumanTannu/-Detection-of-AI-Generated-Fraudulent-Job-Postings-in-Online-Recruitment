# Real Groq pilot configuration. Keep actual credentials in ignored .env only.
GENERATION_MODE=api
ENABLE_LLM_VALIDATION=false

# Set this locally. Never commit a real key.
GROQ_API_KEY='replace-me'
# Optional second Groq account key; the client rotates keys round-robin.
GROQ_API_KEY_2='replace-me'
GENERATION_PROVIDER='groq'
GENERATION_MODEL='openai/gpt-oss-20b'

# OpenRouter production profile. Put the real key in ignored .env only.
OPENROUTER_API_KEY='replace-me'
OPENROUTER_SITE_URL='https://localhost'
OPENROUTER_APP_NAME='EMSCAD Fraud Research'
